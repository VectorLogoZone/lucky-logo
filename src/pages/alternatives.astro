---
import { alternatives } from '../data/alternatives';
import BaseLayout from '../layouts/BaseLayout.astro';

Astro.response.headers.set('Cache-Control', 'public');
---

<BaseLayout title="Alternative Logo Services">
    <table>
        <tbody>
            {alternatives.map((alt) => (
                <tr>
                    <td>{alt.url ? <a href={alt.url}>{alt.name}</a> : alt.name}</td>
                    <td>
                        {alt.detailHtml ? (
                            <details>
                                <summary>{alt.summary}</summary>
                                <div set:html={alt.detailHtml}></div>
                            </details>
                        ) : (
                            alt.summary
                        )}
                    </td>
                </tr>
            ))}
        </tbody>
    </table>
</BaseLayout>
