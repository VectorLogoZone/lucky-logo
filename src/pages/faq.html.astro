---
import { faqs } from '../data/faq';
import BaseLayout from '../layouts/BaseLayout.astro';

Astro.response.headers.set('Cache-Control', 'public');
---

<BaseLayout title="FAQ">
    {faqs.map((faq) => (
        <Fragment>
            <h4 id={faq.slug}>{faq.question}</h4>
            <div set:html={faq.answerHtml}></div>
        </Fragment>
    ))}
</BaseLayout>
