---
import BaseLayout from "../layouts/BaseLayout.astro";
import random from "../data/random.txt";

Astro.response.headers.set("Cache-Control", "public");

const requestUrl = new URL(Astro.request.url);
let website = requestUrl.searchParams.get("url");

// only websites above 1000
const sampleWebsites = random.trim().split("\n").slice(1000);

if (!website || sampleWebsites.includes(website)) {
    website = sampleWebsites[Math.floor(Math.random() * sampleWebsites.length)];
}

const logoUrl = `/logo?url=${encodeURIComponent(website)}`;
const allUrl = `/analyze.html?url=${encodeURIComponent(website)}`;
const origin = requestUrl.origin;
---

<BaseLayout
    h1="Lucky Logo"
    title="Lucky Logo: when you are feeling lucky in your logo search!"
>
    <p>
        Lucky Logo is a quick way to embed a website's logo without doing any
        work. <a href="/faq.html">More...</a>
    </p>

    <form method="GET" action="/">
        <h2>Demo</h2>

        <label>
            URL to use in your img tag:
            <input name="website" value={website} />
        </label>
        <label>
            URL to use in your img tag:
            <input value={`${origin}${logoUrl}`} id="logourl" />
        </label>
        <div class="centered">
            <div class="resultwrapper">
                <a href={allUrl}
                    ><img class="result" src={logoUrl} alt="Logo result" /></a
                >
            </div>
        </div>
        <input type="submit" value="Another demo please!" />
    </form>
</BaseLayout>
